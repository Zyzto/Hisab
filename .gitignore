.firebase/

# ── Secrets / local defines (never commit) ──────────────────────────────────
lib/core/constants/app_secrets.dart
dart_defines_online.json
dart_defines_local.json

# Local secrets folder (keep README + .gitkeep only)
secrets/**
!secrets/.gitkeep
!secrets/README.md
**/fcm-service-account*.json
**/serviceAccount*.json
**/*-firebase-adminsdk-*.json
**/service-account*.json
**/credentials*.json
**/client_secret*.json
**/signing_keys.json
firebase-debug.log
firebase-debug.*.log
*.pem
*.p12
*.key

# Environment files (keep *.example)
.env
.env.*
!**/.env.example
!.env.example
supabase/.env
functions/.env

# Python (uv / venv)
.venv/

# Node (if any tooling is used)
node_modules/
functions/lib/

# Private / personal notes (not for other developers or users)
docs/_private/

# Plan docs (local; not committed)
plans/

# Supabase database backups (never commit)
supabase_backups/
